{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,

    // 👇 let TS resolve your shared alias
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },

  // 👇 Compile only server code (and vite.config.ts because server/vite.ts imports it)
  "include": ["server/**/*.ts", "server/**/*.d.ts", "vite.config.ts"],

  // 👇 Don't compile the React app
  "exclude": ["client", "node_modules"]
}
