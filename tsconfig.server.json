{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": [
    "server/**/*.ts",
    "server/types/**/*.d.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "client/**",
    "attached_assets/**",
    "node_modules/**",
    "vite.config.ts",
    "server/vite.ts",
    "**/*.test.ts"
  ]
}
